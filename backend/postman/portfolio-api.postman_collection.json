{
  "info": {
    "name": "Portfolio API",
    "description": "Shine Aung Khant portfolio API.\n\nSet baseUrl to http://localhost:8080 for local, or to the Render URL (no /api on the end).\nusername is admin. password is changeme locally, and the Render ADMIN_PASSWORD in production.\n\nLogin with a deviceId. A new login replaces the previous device. Use the saved accessToken as Bearer auth, or keep using Basic auth for writes. Refresh rotates the refresh token. Logout revokes the session.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "changeme" },
    { "key": "projectSlug", "value": "saytaman" },
    { "key": "experienceId", "value": "1" },
    { "key": "educationId", "value": "1" },
    { "key": "certificationId", "value": "1" },
    { "key": "deviceId", "value": "postman-device-1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "No Basic auth. 200 returns accessToken (15 minutes) and refreshToken (14 days). Logging in again, even with another deviceId, signs out the previous device."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/auth/login" },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.signature\",\n  \"refreshToken\": \"example-refresh-token\",\n  \"tokenType\": \"Bearer\",\n  \"expiresIn\": 900\n}"
            },
            {
              "name": "401 Unauthorized",
              "originalRequest": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/auth/login" },
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Unauthorized\"\n}"
            }
          ]
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh",
            "description": "Same deviceId as login. The previous refreshToken stops working. A different deviceId returns 401."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/auth/refresh" },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.signature\",\n  \"refreshToken\": \"new-refresh-token\",\n  \"tokenType\": \"Bearer\",\n  \"expiresIn\": 900\n}"
            }
          ]
        },
        {
          "name": "Current session",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/session",
            "description": "Requires the access token. 401 after logout or after a login from another device."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/auth/session" },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"username\": \"admin\",\n  \"deviceId\": \"postman-device-1\"\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "204 and no body. The refresh token and access token for that device stop working."
          },
          "response": [
            {
              "name": "204 No Content",
              "originalRequest": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/auth/logout" },
              "status": "No Content",
              "code": 204,
              "header": [],
              "body": ""
            }
          ]
        }
      ]
    },
